# Public address (domain or IP) that RustDesk clients will use to reach the relay.
# This value is announced by hbbs to clients via the -r flag.
RUSTDESK_RELAY_HOST=rustdesk.example.com

# Relay port — must match the hbbr port published in docker-compose.yml (21117 by default).
RUSTDESK_RELAY_PORT=21117

# Cloudflare DDNS API token — create one with "Edit zone DNS" permissions for your zone.
# See remote/README.md for detailed instructions.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Comma-separated list of domains to update via Cloudflare DDNS.
# Both vpn and rustdesk subdomains should point to your public IP.
DDNS_DOMAINS=vpn.example.com,rustdesk.example.com

# Set to "true" to enable Cloudflare's proxy (orange cloud), or "false" for direct DNS (grey cloud).
# Must be "false" for VPN (WireGuard/OpenVPN) and RustDesk traffic — Cloudflare proxy only routes HTTP/HTTPS.
DDNS_PROXIED=false
