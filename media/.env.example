# Surfshark WireGuard credentials for gluetun.
# Surfshark → VPN → Manual setup → Router/Desktop → WireGuard → "I don't have a key pair" → generate.
# Private key: the generated private key. Address: the `Address` line of any downloaded
# WireGuard config (IPv4 only, e.g. 10.14.0.2/16) — it is the same for every server.
SURFSHARK_WIREGUARD_PRIVATE_KEY=
SURFSHARK_WIREGUARD_ADDRESSES=10.14.0.2/16
# Comma-separated Surfshark countries to pick a server from.
VPN_SERVER_COUNTRIES=Netherlands

# API keys for Sonarr/Radarr/Prowlarr. Choose them yourself — the apps use these instead of
# generating their own. 32 hex chars each: `openssl rand -hex 16`.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
