# PostgreSQL credentials (same as the postgres stack — used by pg_dumpall).
POSTGRES_USER=root
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgresdb

# Databases to exclude entirely from the dump (comma or space separated).
# Excludes the whole database (schema + data). Leave empty to dump everything.
# Example: PG_EXCLUDE_DATABASES=satoshi_scanner
PG_EXCLUDE_DATABASES=

# rclone remote configured with `rclone config` (Google Drive).
# RCLONE_REMOTE = remote name, RCLONE_PATH = destination folder on the Drive.
RCLONE_REMOTE=gdrive
RCLONE_PATH=homelab-backups

# Schedule (standard cron). Default: every day at 03:05.
BACKUP_CRON=5 3 * * *

# Retention.
# LOCAL_KEEP = number of most recent backups kept on the server (1 = latest only).
# REMOTE_RETENTION_DAYS = delete Google Drive copies older than this many days.
LOCAL_KEEP=1
REMOTE_RETENTION_DAYS=7

# Run a backup immediately when the container starts (true/false).
RUN_ON_START=false

# Timezone (used by cron and timestamps).
TZ=Europe/Amsterdam
