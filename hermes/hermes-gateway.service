[Unit]
Description=Hermes Agent gateway (Telegram)
Wants=network-online.target
After=network-online.target hermes-egress.service
# Fail closed: no egress firewall, no agent.
Requires=hermes-egress.service

[Service]
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/workspace
Environment=HOME=/home/hermes
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=HERMES_WRITE_SAFE_ROOT=/home/hermes/.hermes:/home/hermes/workspace
Environment=PATH=/home/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hermes/.local/bin/hermes gateway run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
