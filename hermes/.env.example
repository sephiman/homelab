# Copy to .env, fill in, then run install-host.sh: it installs this file as
# /home/hermes/.hermes/.env (mode 600) and turns HERMES_DB_RO_PASSWORD into ~hermes/.pgpass.

# API key of the model provider in config.yaml `model:` (README "Choosing a model").
# install-host.sh saves it under the variable that provider expects (e.g. OPENCODE_GO_API_KEY).
# OpenCode Go (default) / Zen: https://opencode.ai/auth — OpenRouter: https://openrouter.ai/keys
# Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=changeme
# Key of the fallback provider (config.yaml fallback_providers; OpenRouter by default:
# https://openrouter.ai/keys). Leave it out to run without a fallback.
FALLBACK_API_KEY=changeme

# Home Assistant long-lived token (README "Home Assistant"); stays root-only, read-only use.
# Leave it out to disable the Home Assistant actions.
HA_TOKEN=changeme

# From @BotFather.
TELEGRAM_BOT_TOKEN=changeme
# Your numeric Telegram user id (ask @userinfobot). Comma-separated for more than one.
# This is what lets you talk to the bot, in private chat and in groups.
TELEGRAM_ALLOWED_USERS=123456789
# Optional: the only chats the bot replies in (group ids are negative, usually -100…).
# Never use TELEGRAM_GROUP_ALLOWED_CHATS: it lets every member of the group command the agent.
#TELEGRAM_ALLOWED_CHATS=-1001234567890
# true: in groups, answer only when @mentioned or replied to. false: answer every message you
# send there (each one spends model requests). Others are ignored either way.
TELEGRAM_REQUIRE_MENTION=false

# Web dashboard behind Nginx Proxy Manager, LAN only (README "Web dashboard"). Leave the password
# out to keep it off. install-host.sh stores only a scrypt hash of it in Hermes' .env.
#HERMES_DASHBOARD_PUBLIC_URL=https://hermes.example.com
#HERMES_DASHBOARD_BASIC_AUTH_USERNAME=juanjo
#HERMES_DASHBOARD_PASSWORD=changeme

# Same password you pass to postgres/hermes_ro.sql. No ':' or '\' (it goes into .pgpass).
HERMES_DB_RO_PASSWORD=changeme
