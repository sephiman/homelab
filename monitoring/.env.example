# Grafana admin user (created on first boot only).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# Telegram bot Alertmanager sends alerts through (passed in as compose secrets).
# Create a bot with @BotFather, then get the chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Read-only Postgres role for the crypto-ambush trading dashboard.
# Create the role with postgres/grafana_ro.sql, then put its password here.
AMBUSH_DB_RO_PASSWORD=
