              {"id": "mappings", "value": [
                {"type": "value", "options": {
                  "LONG": {"text": "LONG", "color": "green", "index": 0},
                  "SHORT": {"text": "SHORT", "color": "red", "index": 1}
                }}
              ]},
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": [{"displayName": "since", "desc": true}]}
    },
    {
      "id": 26,
      "type": "table",
      "title": "Recent closed trades (15 per profile)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 43},
      "datasource": {"type": "datasource", "uid": "-- Mixed --"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "ambush-pg"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'BingX' AS profile, pair, side, hit, fill_price, hit_price, round(pnl_percent::numeric, 3) AS pnl_pct, hit_timestamp FROM amb_live_signals WHERE order_status = 'FILLED' AND hit IN ('TP1','TP2','SL') ORDER BY hit_timestamp DESC LIMIT 15"
        },
        {
          "refId": "B",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "ambush-pg-bitmart"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Bitmart' AS profile, pair, side, hit, fill_price, hit_price, round(pnl_percent::numeric, 3) AS pnl_pct, hit_timestamp FROM amb_live_signals WHERE order_status = 'FILLED' AND hit IN ('TP1','TP2','SL') ORDER BY hit_timestamp DESC LIMIT 15"
        },
        {
          "refId": "C",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "ambush-pg-signals"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'signals' AS profile, pair, side, hit, fill_price, hit_price, round(pnl_percent::numeric, 3) AS pnl_pct, hit_timestamp FROM amb_signal_alerts WHERE order_status = 'FILLED' AND hit IN ('TP1','TP2','SL') ORDER BY hit_timestamp DESC LIMIT 15"
