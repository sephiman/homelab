{
  "uid": "homelab-crypto-ambush",
  "title": "Homelab \u2014 Crypto Ambush",
  "description": "The crypto-ambush bots: BingX (LIVE, unified combi 15m+1h, crypto_ambush), Binance (SIGNAL-ONLY, crypto_ambush_signals). Trading performance from Postgres (amb_* tables), ops health from Prometheus (cambush_*), containers from cAdvisor, logs from Loki. Win/PnL semantics mirror the bot's own reports: resolved = FILLED + hit in (TP1,TP2,SL); wins = TP1+TP2; pnl_percent is the bot's bottom-line column.",
  "tags": [
    "homelab",
    "crypto-ambush",
    "trading"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "bot",
        "label": "Bot",
        "type": "custom",
        "description": "Filter the analysis body, ops-health and logs panels to one or more bots. 'All' = every bot (identical to the unfiltered view). The top status header always shows all bots.",
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "query": "BingX : bingx, Signals : binance-signals",
        "options": [
          {
            "text": "BingX",
            "value": "bingx",
            "selected": false
          },
          {
            "text": "Signals",
            "value": "binance-signals",
            "selected": false
          }
        ],
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ],
          "selected": false
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "BingX live \u2014 bot",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - container_last_seen{name=\"ambush-bingx\"}) < bool 120",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "noValue": "DOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
