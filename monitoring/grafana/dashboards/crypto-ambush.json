          "rawSql": "SELECT 'BingX' AS profile, pair, side, coalesce(position_status, order_status) AS status, projected_limit_price AS limit_price, fill_price, stop_loss, take_profit_1, take_profit_2, coalesce(fill_time, limit_placed_time, detected_time, created_at) AS since FROM amb_live_signals WHERE position_status IN ('OPEN','TP1_SECURED') OR order_status IN ('DETECTED','LIMIT_PLACED') ORDER BY 10 DESC"
        },
        {
          "refId": "B",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "ambush-pg-bitmart"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Bitmart' AS profile, pair, side, coalesce(position_status, order_status) AS status, projected_limit_price AS limit_price, fill_price, stop_loss, take_profit_1, take_profit_2, coalesce(fill_time, limit_placed_time, detected_time, created_at) AS since FROM amb_live_signals WHERE position_status IN ('OPEN','TP1_SECURED') OR order_status IN ('DETECTED','LIMIT_PLACED') ORDER BY 10 DESC"
        },
        {
          "refId": "C",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "ambush-pg-signals"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'signals' AS profile, pair, side, coalesce(position_status, order_status) AS status, projected_limit_price AS limit_price, fill_price, stop_loss, take_profit_1, take_profit_2, coalesce(fill_time, limit_placed_time, detected_time, created_at) AS since FROM amb_signal_alerts WHERE position_status IN ('OPEN','TP1_SECURED') OR order_status IN ('DETECTED','LIMIT_PLACED') ORDER BY 10 DESC"
        }
      ],
      "transformations": [{"id": "merge", "options": {}}],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "status"},
