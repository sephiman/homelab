              {"id": "mappings", "value": [
                {"type": "value", "options": {
                  "OPEN": {"text": "OPEN", "color": "green", "index": 0},
                  "TP1_SECURED": {"text": "TP1_SECURED", "color": "blue", "index": 1},
                  "LIMIT_PLACED": {"text": "LIMIT_PLACED", "color": "yellow", "index": 2},
                  "DETECTED": {"text": "DETECTED", "color": "text", "index": 3}
