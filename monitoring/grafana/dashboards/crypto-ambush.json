          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Detected\", count(*) FILTER (WHERE order_status <> 'DETECTED') AS \"Limit placed\", count(*) FILTER (WHERE order_status = 'FILLED') AS \"Filled\", count(*) FILTER (WHERE order_status = 'FILLED' AND hit IN ('TP1','TP2','SL')) AS \"Resolved\", count(*) FILTER (WHERE order_status = 'CANCELLED_EXPIRY') AS \"Expired\", count(*) FILTER (WHERE order_status = 'CANCELLED_INVALIDATION') AS \"Invalidated\" FROM amb_live_signals WHERE $__timeFilter(created_at) AND 'bingx' IN (${bot:singlequote})"
        }
