      "type": "timeseries",
      "title": "Cumulative net PnL %",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ambush-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT hit_timestamp AS \"time\", sum(pnl_percent) OVER (ORDER BY hit_timestamp) AS \"BingX (live)\" FROM amb_live_signals WHERE order_status = 'FILLED' AND hit IN ('TP1','TP2','SL') AND 'bingx' IN (${bot:singlequote}) AND $__timeFilter(hit_timestamp) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ambush-pg-signals"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT hit_timestamp AS \"time\", sum(pnl_percent) OVER (ORDER BY hit_timestamp) AS \"Signals (virtual)\" FROM amb_signal_alerts WHERE order_status = 'FILLED' AND hit IN ('TP1','TP2','SL') AND 'binance-signals' IN (${bot:singlequote}) AND $__timeFilter(hit_timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
