    {
      "id": 7,
      "type": "stat",
      "title": "BingX — win rate (30d)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 4},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "ambush-pg"},
      "targets": [{"refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE hit IN ('TP1','TP2')) / NULLIF(count(*), 0) AS win_rate FROM amb_live_signals WHERE order_status = 'FILLED' AND hit IN ('TP1','TP2','SL') AND hit_timestamp > (now() at time zone 'utc') - interval '30 days'"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "no trades",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 55}, {"color": "green", "value": 65}]}
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
