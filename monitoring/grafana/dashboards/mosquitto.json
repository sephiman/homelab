{
  "uid": "homelab-mosquitto",
  "title": "Homelab — Mosquitto",
  "tags": ["homelab", "mqtt", "mosquitto"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Connected clients",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "broker_clients_connected"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Subscriptions",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "broker_subscriptions_count"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retained messages",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "broker_retained_messages_count"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Broker uptime",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "broker_uptime"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"colorMode": "none"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Clients",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "broker_clients_connected", "legendFormat": "connected"},
        {"refId": "B", "expr": "broker_clients_active", "legendFormat": "active"},
        {"refId": "C", "expr": "broker_clients_inactive", "legendFormat": "inactive"},
        {"refId": "D", "expr": "broker_clients_maximum", "legendFormat": "max ever"}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 10}
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Subscriptions & retained",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "broker_subscriptions_count", "legendFormat": "subscriptions"},
        {"refId": "B", "expr": "broker_retained_messages_count", "legendFormat": "retained"},
        {"refId": "C", "expr": "broker_messages_stored", "legendFormat": "stored"}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 10}
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Message rate (msg/s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(broker_messages_received[5m])", "legendFormat": "received"},
        {"refId": "B", "expr": "-rate(broker_messages_sent[5m])", "legendFormat": "sent"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "custom": {"drawStyle": "line", "fillOpacity": 20}
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Byte rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(broker_bytes_received[5m])", "legendFormat": "rx"},
        {"refId": "B", "expr": "-rate(broker_bytes_sent[5m])", "legendFormat": "tx"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"drawStyle": "line", "fillOpacity": 20}
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PUBLISH messages",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "rate(broker_publish_messages_received[5m])", "legendFormat": "received"},
        {"refId": "B", "expr": "rate(broker_publish_messages_sent[5m])", "legendFormat": "sent"},
        {"refId": "C", "expr": "rate(broker_publish_messages_dropped[5m])", "legendFormat": "dropped"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "custom": {"drawStyle": "line", "fillOpacity": 10}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "dropped"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Load average (msg/s, broker-side)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "broker_load_messages_received_1min", "legendFormat": "rx 1m"},
        {"refId": "B", "expr": "broker_load_messages_received_5min", "legendFormat": "rx 5m"},
        {"refId": "C", "expr": "broker_load_messages_received_15min", "legendFormat": "rx 15m"},
        {"refId": "D", "expr": "broker_load_messages_sent_1min", "legendFormat": "tx 1m"},
        {"refId": "E", "expr": "broker_load_messages_sent_5min", "legendFormat": "tx 5m"},
        {"refId": "F", "expr": "broker_load_messages_sent_15min", "legendFormat": "tx 15m"}
      ],
      "fieldConfig": {"defaults": {"unit": "mps"}}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Dropped (last 1h)",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "increase(broker_publish_messages_dropped[1h])"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 100}
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Bytes received (1h)",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "increase(broker_bytes_received[1h])"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Bytes sent (1h)",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "increase(broker_bytes_sent[1h])"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    }
  ]
}
