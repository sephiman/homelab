{
  "uid": "homelab-csweep",
  "title": "Homelab — Crypto Signal Sweep",
  "tags": ["homelab", "crypto-signal-sweep", "trading"],
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Bot",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(csweep_loop_iterations_total, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bots alive (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(rate(csweep_loop_iterations_total{instance=~\"$instance\"}[5m]) > 0)"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 4}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Signals (24h)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(csweep_signals_emitted_total{instance=~\"$instance\"}[24h]))"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Telegram errors (1h)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(csweep_telegram_send_errors_total{instance=~\"$instance\"}[1h]))"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB errors (1h)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(csweep_db_write_errors_total{instance=~\"$instance\"}[1h]))"}],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Loop iterations / sec",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(csweep_loop_iterations_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{instance}} ({{profile}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line", "fillOpacity": 10}
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Loop duration (p50 / p95)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (instance, le) (rate(csweep_loop_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50 {{instance}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(csweep_loop_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p95 {{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Signals/min by direction",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(csweep_signals_emitted_total{instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "fillOpacity": 70, "stacking": {"mode": "normal"}}
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Exchange call latency p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (exchange, endpoint, le) (rate(csweep_exchange_request_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{exchange}} / {{endpoint}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Candle freshness — lag since last fetched candle",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 20},
      "description": "Seconds since the most recent candle for each (exchange, symbol, timeframe). If lag exceeds the timeframe's interval by 2-3× the data feed is stale.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "time() - csweep_last_candle_timestamp{instance=~\"$instance\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{exchange}}/{{symbol}}/{{tf}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "compose_project": true,
              "compose_service": true
            },
            "indexByName": {
              "exchange": 0,
              "symbol": 1,
              "tf": 2,
              "instance": 3,
              "Value": 4
            },
            "renameByName": {
              "exchange": "Exchange",
              "symbol": "Symbol",
              "tf": "TF",
              "instance": "Bot",
              "Value": "Lag (s)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {"fields": {}, "sort": [{"field": "Lag (s)", "desc": true}]}
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Lag (s)"},
            "properties": [
              {"id": "unit", "value": "s"},
              {
                "id": "custom.cellOptions",
                "value": {"type": "color-background", "mode": "gradient"}
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "yellow", "value": 300},
                    {"color": "orange", "value": 900},
                    {"color": "red", "value": 1800}
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Exchange errors / min by code",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (exchange, code) (rate(csweep_exchange_errors_total{instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{exchange}} / {{code}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Side errors / min (Telegram + DB)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(csweep_telegram_send_errors_total{instance=~\"$instance\"}[5m]) * 60",
          "legendFormat": "telegram {{instance}}"
        },
        {
          "refId": "B",
          "expr": "sum by (db) (rate(csweep_db_write_errors_total{instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "db {{db}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Process — RSS memory",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{instance=~\"$instance\",job=\"docker\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Process — CPU",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{instance=~\"$instance\",job=\"docker\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Pair pipeline duration p50 / p95 by TF",
      "description": "End-to-end per-pair pipeline latency (fetch + analyze + save + alert), split by timeframe.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 47},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (tf, le) (rate(csweep_pair_pipeline_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50 {{tf}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (tf, le) (rate(csweep_pair_pipeline_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "p95 {{tf}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Stale candles / min by outcome",
      "description": "Pair pipelines that hit a stale-candle path and either recovered or were abandoned.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 47},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tf, outcome) (rate(csweep_pair_stale_total{instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{tf}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "fillOpacity": 70, "stacking": {"mode": "normal"}}
        }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Signal funnel",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 55}
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Skip reasons (1h, top causes)",
      "description": "Why pair pipelines rejected before emitting a signal. Skewed buckets tell you what to relax to lift volume — or what's keeping quality up.",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 56},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (reason) (increase(csweep_pair_skipped_total{instance=~\"$instance\"}[1h])))",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Skip reasons / min by reason",
      "description": "Rate of pair-pipeline rejections by reason. Watch for sudden jumps when a config change shifts which gate is biting.",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 56},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(csweep_pair_skipped_total{instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}}
    },
    {
      "id": 19,
      "type": "piechart",
      "title": "Signals by MTF confidence (24h)",
      "description": "Emitted-signal distribution across VERY_HIGH / HIGH / MEDIUM / LOW. A healthy mix skews HIGH/VERY_HIGH; growth of LOW signals means MTF gates are slipping.",
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 66},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (confidence) (increase(csweep_signals_by_confidence_total{instance=~\"$instance\"}[24h]))",
          "legendFormat": "{{confidence}}",
          "instant": true
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "values": ["value", "percent"]}}
    },
    {
      "id": 20,
      "type": "piechart",
      "title": "Signals by regime (24h)",
      "description": "Emitted-signal distribution across momentum vs mean-reversion. Tilts hint at which kind of market the strategy is actually firing in.",
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 66},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (regime) (increase(csweep_signals_by_regime_total{instance=~\"$instance\"}[24h]))",
          "legendFormat": "{{regime}}",
          "instant": true
        }
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "values": ["value", "percent"]}}
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Active pending signals",
      "description": "Live signals in PENDING or TP1_HIT state right now. Each open one blocks new signals for that pair across all timeframes.",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 66},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tf, status) (csweep_active_pending_signals{instance=~\"$instance\"})",
          "legendFormat": "{{tf}} / {{status}}",
          "instant": true
        }
      ],
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 22,
      "type": "row",
      "title": "Signal outcomes",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 75}
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Outcomes / hour by hit (TP1 / TP2 / SL)",
      "description": "Resolution rate by hit type. TP1 means the breakeven-exit branch (TP1 hit, then SL pulled to BE). TP1_HIT (intermediate) is excluded — those resolve to TP2 or TP1.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 76},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (hit) (rate(csweep_signal_outcomes_total{instance=~\"$instance\",hit=~\"TP1|TP2|SL\"}[1h])) * 3600",
          "legendFormat": "{{hit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "fillOpacity": 70, "stacking": {"mode": "normal"}}
        }
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Win rate (24h)",
      "description": "(TP1 + TP2) / (TP1 + TP2 + SL) over the last 24h. TP1 counts as a partial win because the position banked profit at TP1 before exiting at breakeven.",
      "gridPos": {"h": 9, "w": 6, "x": 12, "y": 76},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(csweep_signal_outcomes_total{instance=~\"$instance\",hit=~\"TP1|TP2\"}[24h])) / clamp_min(sum(increase(csweep_signal_outcomes_total{instance=~\"$instance\",hit=~\"TP1|TP2|SL\"}[24h])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 55},
              {"color": "green", "value": 70}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 25,
      "type": "stat",
      "title": "SL → BE moves (24h)",
      "description": "Signals where TP1 triggered the SL-to-breakeven move in the last 24h. A high count vs final TP2 means a lot of trades are getting locked in but not closing for full profit.",
      "gridPos": {"h": 9, "w": 6, "x": 18, "y": 76},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(csweep_sl_moved_to_be_total{instance=~\"$instance\"}[24h]))"
        }
      ],
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Time-to-hit p50 / p95 by outcome",
      "description": "Wall-clock seconds from signal creation to TP/SL resolution. Long tails on SL hint at slow grinding losses; very short TP2 spikes hint at chasing momentum.",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 85},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (hit, le) (rate(csweep_signal_time_to_hit_seconds_bucket{instance=~\"$instance\"}[1h])))",
          "legendFormat": "p50 {{hit}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (hit, le) (rate(csweep_signal_time_to_hit_seconds_bucket{instance=~\"$instance\"}[1h])))",
          "legendFormat": "p95 {{hit}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}}
    }
  ]
}
