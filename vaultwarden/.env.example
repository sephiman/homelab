# Public HTTPS URL of the vault, exactly as clients will type it (no trailing slash).
# Must be HTTPS: the web vault and clients refuse to work over plain HTTP.
VAULTWARDEN_DOMAIN=https://vault.example.com

# Password of the `vaultwarden` Postgres role (created with postgres/vaultwarden.sql).
# It goes inside a URL, so keep it URL-safe: `openssl rand -hex 32`.
VAULTWARDEN_DB_PASSWORD=changeme
POSTGRES_HOST=postgresdb

# Admin panel (/admin) token, stored as an Argon2 hash. Generate it with:
#   docker run --rm -it vaultwarden/server:1.37.3 /vaultwarden hash
# Keep the SINGLE QUOTES — the hash contains `$`, which Compose would otherwise expand.
ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$REPLACE_ME'

# Open registration. Set to true only while creating your account, then back to false.
SIGNUPS_ALLOWED=false
# Lets you invite family/friends from the admin panel while signups stay closed.
INVITATIONS_ALLOWED=true

# SMTP (optional, but needed for email 2FA, invitation emails and emergency access).
# Uncomment to enable mail. Leave them commented out (not blank) to disable it.
# SMTP_FROM must be a bare address; the display name goes in SMTP_FROM_NAME.
# Gmail: SMTP_HOST=smtp.gmail.com, port 587 + starttls, and SMTP_PASSWORD is a
# Google App Password (16 letters, no spaces), not your normal Google password.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vault@example.com
# SMTP_FROM_NAME=Vaultwarden
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

TZ=Europe/Amsterdam
